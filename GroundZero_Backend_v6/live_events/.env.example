# Copy this file to live_events/.env (or set these as real environment
# variables) to override the defaults in app/config.py.
#
# NOTE: these use an EVENTS_ prefix so this module's settings can never
# collide with the main Ground Zero app's identically-named DATABASE_URL
# etc. when both run in the same process (see ../main.py, which mounts
# this module's app/lifespan directly). If you run this module completely
# standalone (`uvicorn app.main:app` from inside live_events/), these same
# prefixed names still apply.
# In production (ENVIRONMENT != "development"), both of these are
# REQUIRED — app/config.py now refuses to start without them rather than
# silently using a SQLite file or a well-known default key. Set
# EVENTS_DATABASE_URL to a real Postgres URL and EVENTS_ADMIN_API_KEY to
# a real secret before deploying. Left unset, local development still
# works exactly as before (ENVIRONMENT=development's own fallback).
# EVENTS_DATABASE_URL=postgresql://user:password@host:5432/groundzero_events
# EVENTS_ADMIN_API_KEY=generate-a-real-secret-for-this-deployment
EVENTS_REFRESH_INTERVAL_MINUTES=30
EVENTS_MAX_EVENT_AGE_HOURS=36
EVENTS_REQUEST_TIMEOUT_SECONDS=20
EVENTS_USER_AGENT=GroundZeroEvents/1.0 (+https://localhost/groundzero-events; contact via project owner)
