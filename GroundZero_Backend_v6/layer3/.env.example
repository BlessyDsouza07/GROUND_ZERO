# Ground Zero — Layer 3 environment template.
# Copy this file to ".env" in the same folder (layer3/.env) and fill in what applies.
# Every value here has a sane default in layer3_config.py — you only need to set what
# differs from that default. Nothing in this file is required to run `--demo`.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
LAYER3_HOST=0.0.0.0
LAYER3_PORT=8004
LAYER3_TIMEZONE=Asia/Kolkata
LAYER3_LOG_LEVEL=INFO
# LAYER3_API_KEY=              # if set, every request (except /health) needs header X-API-Key
# LAYER3_ADMIN_TOKEN=          # if set, /l3/safety/advisory needs header X-Admin-Token (else localhost-only)
LAYER3_CORS_ORIGINS=*
# LAYER3_ALLOW_TIME_OVERRIDE=true   # dev/demo only — lets requests pass a fake "now"

# ---------------------------------------------------------------------------
# Storage — Layer 3's OWN tables. Defaults to its own SQLite file; never touches
# Layer 0/1/2 tables. Set LAYER3_SHARE_GROUND_ZERO_DB=true to store Layer 3's
# l3_* tables inside Layer 0's ground_zero.db instead (still separate tables).
# ---------------------------------------------------------------------------
# LAYER3_DATABASE_URL=sqlite:///data_output/layer3.db
# LAYER3_SHARE_GROUND_ZERO_DB=false
# For PostgreSQL (production): LAYER3_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/groundzero

# ---------------------------------------------------------------------------
# Upstream layers (READ-ONLY from Layer 3's point of view)
# ---------------------------------------------------------------------------
# LAYER0_MASTER_CORE_PATH=../layer0_fixed/data_output/master_data_core.json
# LAYER0_DATA_DIR=../layer0_fixed/data_output          # where live_tide_cache.json / live_events_cache.json live
# LAYER0_DB_PATH=../layer0_fixed/data_output/ground_zero.db
# LAYER3_USE_LAYER0_DB_FLAGS=true          # read live temporarily_unavailable flags straight from Layer 0's DB
# LAYER1_PROFILES_DIR=../layer1/data_output/profiles
LAYER1_BASE_URL=http://localhost:8002
LAYER2_BASE_URL=http://localhost:8003

# ---------------------------------------------------------------------------
# Redis (OPTIONAL) — written by Layer 4's background workers, read by Layer 3
# so the Context Engine never waits on a slow live API at the moment of arrival.
# Layer 3 works perfectly without Redis; it just calls the free APIs directly.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Ask Engine LLM (OPTIONAL) — Groq's free tier, OpenAI-compatible API.
# Get a free key at https://console.groq.com/keys
# With no key, the Ask Engine still works fully via its deterministic
# extractive engine — it just phrases answers a bit less fluently.
# ---------------------------------------------------------------------------
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LAYER3_LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
# LAYER3_VOICE_USE_LLM=false     # set true to also let the LLM polish the companion_voice line

# ---------------------------------------------------------------------------
# Live safety advisory feed (OPTIONAL) — any public RSS/Atom/CAP feed for
# Karnataka / Dakshina Kannada / coastal advisories. Leave unset to rely on
# weather-API alerts + the admin advisory endpoint only.
# ---------------------------------------------------------------------------
# LAYER3_ADVISORY_FEED_URL=https://sdma.karnataka.gov.in/rss/alerts.xml
