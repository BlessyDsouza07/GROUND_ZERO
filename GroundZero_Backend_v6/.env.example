# Copy to .env and fill in real values. Nothing in this codebase falls back
# to fake data when a value here is missing — the relevant collector or
# feature will raise SourceUnavailable / fail startup validation instead.

DATABASE_URL=postgresql+asyncpg://groundzero:groundzero@localhost:5432/groundzero
REDIS_URL=redis://localhost:6379/0

OVERPASS_URL=https://overpass-api.de/api/interpreter
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php

# Get a free key at https://openweathermap.org/api (One Call API 3.0)
OPENWEATHER_API_KEY=your_openweather_api_key_here


# Get a key at https://www.worldtides.info/
TIDE_API_KEY=your_tide_api_key_here


# Comma-separated RSS feed URLs for local Mangaluru events/festivals
EVENT_RSS_FEED_URLS=https://news.google.com/rss/search?
q=Mangaluru%20festival%20OR%20event%20OR%20mela&hl=en-IN&gl=IN&ceid=IN:en


# Free, rate-limit-free CSV path for community/curator-added places — see
# docs/GROWING_THE_DATABASE.md. Missing file = zero rows contributed, not
# an error.
SPREADSHEET_PLACES_CSV_PATH=data/community_places.csv

# Zero-API, zero-rate-limit OSM collection. Point this at a locally
# downloaded .osm / .osm.pbf file (see
# layer0/infrastructure/collectors/bulk_osm_extract_collector.py for
# exactly where to get one for free) and it REPLACES the live Overpass
# collector entirely — no network call, no rate limit at pipeline-run
# time. Leave blank to keep using the live (also free/legal) Overpass API.
OSM_EXTRACT_FILE_PATH=data/mangaluru.osm.pbf

# Set to false for a fully offline pipeline run with zero API calls of any
# kind (Wikidata/Wikipedia enrichment skipped — places still get
# everything OSM/the spreadsheet provided, just without extra description
# text). Combine with OSM_EXTRACT_FILE_PATH set above for zero network
# calls whatsoever.
ENABLE_WIKIDATA_WIKIPEDIA_ENRICHMENT=true

# Mangaluru bounding box — widen only if you deliberately want a larger region
BBOX_SOUTH=12.75
BBOX_WEST=74.78
BBOX_NORTH=13.05
BBOX_EAST=75.05

ENVIRONMENT=development

# Required for every /admin/* endpoint (pipeline runs, community
# moderation, stats). Generate a real random secret for this — e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` — and
# send it as the X-Admin-Api-Key header on admin requests. Left empty,
# every admin request is REJECTED (fails closed, not open).
ADMIN_API_KEY=3zEjjr2BPuHn977kdgucH83ltt8-QAVF3_0kBQ6gTbI

# --- Accounts (auth/) ---
# Required for POST /auth/register and /auth/login. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=TzM5GX-XK8u9vsIvLrGUipZh1ksuwkjMtdY6kQtPnNPM4-XQT6LUuE2v5ZUwZ8-i

# --- Layer 3 (Context Engine / Silence Filter / Ask Engine) ---------------
# In this combined deployment Layer 3 talks to Layer 1 and Layer 2 on this
# SAME app (see main.py) rather than the separate 8002/8003 ports its own
# standalone mode (layer3/run_layer3.py --serve) defaults to. Only change
# this if you deploy the combined app behind a different host/port.
GROUNDZERO_BASE_URL=http://localhost:8000

# Optional: lets Layer 3's Ask Engine call a real LLM (Groq, free tier) for
# questions a place's own stored record can't answer. Leave blank and the
# Ask Engine still works, extractively, from each place's stored
# description/wiki_summary/etc. — see layer3/README.md.
GROQ_API_KEY=your_groq_api_key_here
# --- Live Mangaluru Events (live_events/) ----------------------------------
# This module's OWN settings are intentionally namespaced (EVENTS_ prefix)
# and read from live_events/.env, not this file — see
# live_events/app/config.py and live_events/.env.example. Copy that file to
# live_events/.env if you want to override its defaults (admin key, refresh
# interval, etc.). Nothing further is required here for it to run.

# --- Layer 4 (live OSM navigation) ---------------------------------------
# Free public OSM/OSRM routing. Override with your own server for production.
LAYER4_OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
LAYER4_OSRM_FALLBACK_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
LAYER4_ROUTING_TIMEOUT_S=8